#!/usr/bin/env bash
set -Eeuo pipefail

readonly EXIT_FAILED=1 EXIT_USAGE=2 EXIT_LOCKED=75

# Settings that may come from the environment or the config file.
# Precedence: command-line flags > environment > config file > defaults.
readonly SETTINGS=(
    PROJECTS_FILE LOCK_FILE LOCK_WAIT WAIT_TIMEOUT COMMAND_TIMEOUT
    REMOVE_ORPHANS PRUNE_IMAGES PRUNE_UNTIL NOTIFY_COMMAND NOTIFY_ON DRY_RUN
    SCHEDULE SCHEDULE_RANDOM_DELAY
)
readonly TIMER_UNIT=docker-compose-weekly-update.timer

usage() {
    cat <<'EOF'
Usage: docker-compose-weekly-update [options] [PROJECT_DIR...]

Pull images and redeploy the Docker Compose projects in the allowlist.
With PROJECT_DIR arguments, only those allowlisted projects are updated.

Options:
  -c, --config FILE     Settings file (default: /etc/docker-compose-updater/updater.conf)
  -p, --projects FILE   Project allowlist (default: /etc/docker-compose-updater/projects)
  -n, --dry-run         Validate projects and print what would run, change nothing
      --apply-schedule  Write SCHEDULE to the systemd timer and exit, updating nothing
  -h, --help            Show this help

Exit status: 0 success, 1 one or more projects failed, 2 usage or
configuration error, 75 another run holds the lock.
EOF
}

die() {
    echo "ERROR: $1" >&2
    exit "${2:-$EXIT_USAGE}"
}

# Prints 1 or 0; fails on anything that is not a recognised boolean.
parse_bool() {
    case "${1,,}" in
        1 | y | yes | true | on) echo 1 ;;
        0 | n | no | false | off | "") echo 0 ;;
        *) return 1 ;;
    esac
}

require_uint() {
    [[ "$2" =~ ^[0-9]+$ ]] || die "$1 must be a non-negative integer, got: $2"
}

strip_trailing_slashes() {
    local path="$1"
    [[ "$path" =~ ^/+$ ]] || path="${path%"${path##*[!/]}"}"
    printf '%s' "$path"
}

load_config() {
    local file="$1" var
    local -A from_env=()

    # The file is sourced, so as root it must not be editable by anyone else.
    if (( EUID == 0 )) && [[ -z "$(find "$file" -maxdepth 0 -user root ! -perm /022)" ]]; then
        die "$file must be owned by root and not writable by group or others."
    fi

    for var in "${SETTINGS[@]}"; do
        if [[ -v "$var" ]]; then
            from_env[$var]="${!var}"
        fi
    done
    # shellcheck source=/dev/null
    source "$file"
    for var in "${!from_env[@]}"; do
        printf -v "$var" '%s' "${from_env[$var]}"
    done
}

# Run a command with stdin detached and a hard time limit (0 = no limit).
run_limited() {
    local limit="$1"
    shift
    timeout --kill-after=30 "$limit" "$@" </dev/null
}

# Write SCHEDULE into a timer drop-in so it survives reinstalling the unit.
apply_schedule() {
    local systemd_dir="${SYSTEMD_DIR:-/etc/systemd/system}"
    local dropin_dir="$systemd_dir/$TIMER_UNIT.d"
    local stamp="/var/lib/systemd/timers/stamp-$TIMER_UNIT"
    local was_active=0

    systemd-analyze calendar "$SCHEDULE" >/dev/null ||
        die "SCHEDULE is not a valid systemd calendar expression: $SCHEDULE"
    systemd-analyze timespan "$SCHEDULE_RANDOM_DELAY" >/dev/null ||
        die "SCHEDULE_RANDOM_DELAY is not a valid time span: $SCHEDULE_RANDOM_DELAY"
    [[ -w "$systemd_dir" ]] || die "Cannot write to $systemd_dir; run with sudo."

    mkdir -p "$dropin_dir"
    printf '%s\n' \
        "# Generated by docker-compose-weekly-update --apply-schedule from" \
        "# SCHEDULE and SCHEDULE_RANDOM_DELAY. Change those settings and" \
        "# re-apply instead of editing this file." \
        "[Timer]" \
        "OnCalendar=" \
        "OnCalendar=$SCHEDULE" \
        "RandomizedDelaySec=$SCHEDULE_RANDOM_DELAY" \
        >"$dropin_dir/schedule.conf"
    systemctl daemon-reload

    if systemctl is-active --quiet "$TIMER_UNIT"; then
        was_active=1
        systemctl stop "$TIMER_UNIT"
    fi
    # Persistent=true would otherwise run the update immediately when the
    # new schedule has an occurrence between the last run and now.
    if [[ -e "$stamp" ]]; then touch "$stamp"; fi
    if (( was_active )); then systemctl start "$TIMER_UNIT"; fi

    echo "Schedule set to: $SCHEDULE (random delay up to $SCHEDULE_RANDOM_DELAY)"
    if (( was_active )); then
        systemctl list-timers --all --no-pager "$TIMER_UNIT" || true
    fi
}

cli_config="" cli_projects="" cli_dry_run="" cli_apply_schedule=0
only=()
while (( $# > 0 )); do
    case "$1" in
        -c | --config)
            (( $# >= 2 )) || die "$1 requires a file argument."
            cli_config="$2"
            shift 2
            ;;
        -p | --projects)
            (( $# >= 2 )) || die "$1 requires a file argument."
            cli_projects="$2"
            shift 2
            ;;
        -n | --dry-run)
            cli_dry_run=yes
            shift
            ;;
        --apply-schedule)
            cli_apply_schedule=1
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            only+=("$@")
            break
            ;;
        -*)
            usage >&2
            die "Unknown option: $1"
            ;;
        *)
            only+=("$1")
            shift
            ;;
    esac
done

default_config=/etc/docker-compose-updater/updater.conf
config_file="${cli_config:-${CONFIG_FILE:-$default_config}}"
if [[ -e "$config_file" ]]; then
    [[ -r "$config_file" ]] || die "Cannot read $config_file"
    load_config "$config_file"
elif [[ "$config_file" != "$default_config" ]]; then
    die "Config file not found: $config_file"
fi

PROJECTS_FILE="${cli_projects:-${PROJECTS_FILE:-/etc/docker-compose-updater/projects}}"
LOCK_FILE="${LOCK_FILE:-/run/lock/docker-compose-weekly-update.lock}"
LOCK_WAIT="${LOCK_WAIT:-0}"
WAIT_TIMEOUT="${WAIT_TIMEOUT:-120}"
COMMAND_TIMEOUT="${COMMAND_TIMEOUT:-1800}"
REMOVE_ORPHANS="${REMOVE_ORPHANS:-no}"
PRUNE_IMAGES="${PRUNE_IMAGES:-dangling}"
PRUNE_UNTIL="${PRUNE_UNTIL:-168h}"
NOTIFY_COMMAND="${NOTIFY_COMMAND:-}"
NOTIFY_ON="${NOTIFY_ON:-failure}"
DRY_RUN="${cli_dry_run:-${DRY_RUN:-no}}"
SCHEDULE="${SCHEDULE:-Sun *-*-* 04:00:00}"
SCHEDULE_RANDOM_DELAY="${SCHEDULE_RANDOM_DELAY:-15m}"

require_uint LOCK_WAIT "$LOCK_WAIT"
require_uint WAIT_TIMEOUT "$WAIT_TIMEOUT"
require_uint COMMAND_TIMEOUT "$COMMAND_TIMEOUT"
case "$PRUNE_IMAGES" in
    none | dangling | all) ;;
    *) die "PRUNE_IMAGES must be none, dangling, or all, got: $PRUNE_IMAGES" ;;
esac
case "$NOTIFY_ON" in
    never | failure | change | always) ;;
    *) die "NOTIFY_ON must be never, failure, change, or always, got: $NOTIFY_ON" ;;
esac
dry_run="$(parse_bool "$DRY_RUN")" || die "DRY_RUN must be yes or no, got: $DRY_RUN"
parse_bool "$REMOVE_ORPHANS" >/dev/null ||
    die "REMOVE_ORPHANS must be yes or no, got: $REMOVE_ORPHANS"

if (( cli_apply_schedule )); then
    apply_schedule
    exit 0
fi

exec 9>"$LOCK_FILE"
if ! flock -w "$LOCK_WAIT" 9; then
    die "Another update run is already in progress." "$EXIT_LOCKED"
fi

[[ -r "$PROJECTS_FILE" ]] || die "Cannot read $PROJECTS_FILE"
command -v docker >/dev/null || die "Docker is not installed or not in PATH."
docker compose version

updated=() unchanged=() failures=()
declare -A seen=() matched=()

fail() {
    echo "ERROR: $2: $1" >&2
    failures+=("$1 ($2)")
}

update_project() {
    local line="$1" project key value
    local files="" wait_timeout="$WAIT_TIMEOUT" remove_orphans="$REMOVE_ORPHANS"

    # Trailing key=value tokens are per-project options; the rest is the path.
    while [[ "$line" =~ ^(.*[^[:space:]])[[:space:]]+([a-z_]+)=([^[:space:]]*)$ ]]; do
        line="${BASH_REMATCH[1]}"
        key="${BASH_REMATCH[2]}"
        value="${BASH_REMATCH[3]}"
        case "$key" in
            files) files="$value" ;;
            wait_timeout) wait_timeout="$value" ;;
            remove_orphans) remove_orphans="$value" ;;
            *)
                fail "$line" "Unknown project option '$key'"
                return 0
                ;;
        esac
    done
    project="$(strip_trailing_slashes "$line")"

    if [[ -n "${seen[$project]:-}" ]]; then
        return 0
    fi
    seen[$project]=1

    if (( ${#only[@]} > 0 )); then
        [[ -n "${matched[$project]+x}" ]] || return 0
        matched[$project]=1
    fi

    echo
    echo "========================================"
    echo "Updating: $project"
    echo "========================================"

    if [[ "$project" != /* || ! -d "$project" ]]; then
        fail "$project" "Invalid project directory"
        return 0
    fi
    if [[ ! "$wait_timeout" =~ ^[0-9]+$ ]]; then
        fail "$project" "Invalid wait_timeout '$wait_timeout'"
        return 0
    fi
    if ! remove_orphans="$(parse_bool "$remove_orphans")"; then
        fail "$project" "Invalid remove_orphans value"
        return 0
    fi

    local compose=(docker compose) file found=0
    if [[ -n "$files" ]]; then
        local file_list
        IFS=, read -ra file_list <<<"$files"
        for file in "${file_list[@]}"; do
            compose+=(-f "$file")
        done
    else
        # No -f here: Compose then merges compose.override.* and honours
        # COMPOSE_FILE from .env. The check stops Compose from walking up
        # into a parent directory's project.
        for file in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
            if [[ -f "$project/$file" ]]; then
                found=1
                break
            fi
        done
        if (( ! found )); then
            fail "$project" "No supported Compose file found"
            return 0
        fi
    fi

    cd "$project"

    if ! run_limited "$COMMAND_TIMEOUT" "${compose[@]}" config -q; then
        fail "$project" "Invalid Compose configuration"
        return 0
    fi

    local up=("${compose[@]}" up -d --wait --wait-timeout "$wait_timeout")
    if (( remove_orphans )); then up+=(--remove-orphans); fi

    if (( dry_run )); then
        echo "DRY-RUN: ${compose[*]} pull --ignore-buildable"
        echo "DRY-RUN: ${up[*]}"
        unchanged+=("$project")
        return 0
    fi

    local before after up_limit="$COMMAND_TIMEOUT"
    before="$("${compose[@]}" images -q 2>/dev/null </dev/null | sort -u || true)"

    if ! run_limited "$COMMAND_TIMEOUT" "${compose[@]}" pull --ignore-buildable; then
        fail "$project" "Image pull failed"
        return 0
    fi

    # The hard limit must leave room for the health-check wait.
    if (( up_limit > 0 && up_limit < wait_timeout + 60 )); then
        up_limit=$(( wait_timeout + 60 ))
    fi
    if ! run_limited "$up_limit" "${up[@]}"; then
        fail "$project" "Deployment failed"
        return 0
    fi

    after="$("${compose[@]}" images -q 2>/dev/null </dev/null | sort -u || true)"
    if [[ "$before" != "$after" ]]; then
        echo "SUCCESS (updated): $project"
        updated+=("$project")
    else
        echo "SUCCESS (no change): $project"
        unchanged+=("$project")
    fi
}

# Projects named on the command line start unmatched (0) and flip to 1 once
# they are found in the allowlist.
for wanted in "${only[@]}"; do
    matched[$(strip_trailing_slashes "$wanted")]=0
done

mapfile -t lines <"$PROJECTS_FILE"
for line in "${lines[@]}"; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    update_project "$line"
    cd /
done

for wanted in "${!matched[@]}"; do
    if [[ "${matched[$wanted]}" == 0 ]]; then
        fail "$wanted" "Not in the allowlist $PROJECTS_FILE"
    fi
done

if (( ! dry_run )); then
    case "$PRUNE_IMAGES" in
        dangling) prune=(docker image prune -f) ;;
        all) prune=(docker image prune -af --filter "until=$PRUNE_UNTIL") ;;
        none) prune=() ;;
    esac
    if (( ${#prune[@]} > 0 )); then
        echo
        echo "Pruning unused images ($PRUNE_IMAGES)..."
        run_limited "$COMMAND_TIMEOUT" "${prune[@]}" ||
            echo "WARNING: Image prune failed." >&2
    fi
fi

status=success
if (( ${#failures[@]} > 0 )); then status=failure; fi

summary="Docker Compose update on $(hostname): $status
Updated: ${#updated[@]}, unchanged: ${#unchanged[@]}, failed: ${#failures[@]}"
for item in "${updated[@]}"; do summary+=$'\n'"  updated:   $item"; done
for item in "${unchanged[@]}"; do summary+=$'\n'"  unchanged: $item"; done
for item in "${failures[@]}"; do summary+=$'\n'"  FAILED:    $item"; done

echo
echo "$summary"

send=0
case "$NOTIFY_ON" in
    always) send=1 ;;
    change) if [[ "$status" == failure ]] || (( ${#updated[@]} > 0 )); then send=1; fi ;;
    failure) if [[ "$status" == failure ]]; then send=1; fi ;;
esac
if (( send && ! dry_run )) && [[ -n "$NOTIFY_COMMAND" ]]; then
    UPDATER_STATUS="$status" \
        UPDATER_UPDATED="${#updated[@]}" \
        UPDATER_UNCHANGED="${#unchanged[@]}" \
        UPDATER_FAILED="${#failures[@]}" \
        timeout --kill-after=10 60 bash -c "$NOTIFY_COMMAND" <<<"$summary" ||
        echo "WARNING: Notification command failed." >&2
fi

if [[ "$status" == failure ]]; then
    exit "$EXIT_FAILED"
fi
